# Supabase project settings (Project Settings → API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, NEVER exposed to the browser. Used only by
# the public survey routes (src/lib/supabase/admin.ts) and the seed scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL used to build survey links (app.com/pesquisa/<token>).
# In production, set this to your real domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project settings (Project Settings → API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, NEVER exposed to the browser. Used only by
# the public survey routes (src/lib/supabase/admin.ts) and the seed scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL used to build survey links (app.com/pesquisa/<token>).
# In production, set this to your real domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Performance dashboard (/admin/performance) — Meta Ads + Tiny (Olist)
# ----------------------------------------------------------------------------
# Meta: System User token from Business Manager (Business Settings → Users →
# System users → Generate token) with the `ads_read` permission, and the ad
# account ID (with or without the "act_" prefix).
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Optional — Graph API version (default v23.0).
# META_API_VERSION=v23.0

# Tiny ERP API v2 token (Tiny → Configurações → Outras configurações → Token API).
TINY_API_TOKEN=
# Optional — minimum gap between Tiny requests in ms (default 2100 ≈ 28/min).
# Lower it only if your Tiny plan allows more requests per minute.
# TINY_REQUEST_INTERVAL_MS=2100

# Optional — how many days the first sync pulls (default 90).
# SYNC_BACKFILL_DAYS=90

# Secret the daily cron sends as "Authorization: Bearer <CRON_SECRET>".
# Generate with: openssl rand -hex 32
CRON_SECRET=

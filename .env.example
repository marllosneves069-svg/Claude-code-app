# Supabase project settings (Project Settings → API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, NEVER exposed to the browser. Used only by
# the public survey routes (src/lib/supabase/admin.ts) and the seed scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL used to build survey links (app.com/pesquisa/<token>).
# In production, set this to your real domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Diagnóstico Empresarial 360 — usa um projeto Supabase PRÓPRIO, separado do
# projeto acima (Pulse). Crie um segundo projeto em supabase.com e rode a
# migration supabase/migrations/0001_diagnostico_360_init.sql nele.
# ---------------------------------------------------------------------------
DIAGNOSTICO_SUPABASE_URL=https://your-diagnostico-project.supabase.co
DIAGNOSTICO_SUPABASE_SERVICE_ROLE_KEY=your-diagnostico-service-role-key

# Destino do botão final "QUERO UMA ANÁLISE ESTRATÉGICA" na tela de
# resultado. Pode ser um link do WhatsApp (https://wa.me/55...) ou uma
# página de agendamento (Calendly, etc.). Deixe em branco para usar "#".
NEXT_PUBLIC_DIAGNOSTICO_CTA_URL=
